<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="utf-8" />
    <link rel="stylesheet" href="/css/globals.css" />
    <link rel="stylesheet" href="/css/styleguide.css" />
    <link rel="stylesheet" href="/css/style.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    
    <style>
        .sitemap-link {
            display: block;
            padding: 8px 0; 
            color: #6c757d; 
            transition: all 0.2s ease;
            text-decoration: none;
            font-size: 1.05rem; 
        }
        .sitemap-link:hover {
            color: #000; 
            transform: translateX(5px); 
            text-decoration: underline;
        }
    </style>
  </head>

  <body>

<nav class="navbar navbar-expand-lg bg-light border-bottom py-3">
    <div class="container">
        <a class="navbar-brand fw-bold" href="#">Ecommerce</a>

        <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="navMenu" class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto ms-4 gap-3">
                <li class="nav-item"><a class="nav-link" href="/shop">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/shop">Shop</a></li>
                <li class="nav-item"><a class="nav-link" href="/blogs">Blogs</a></li>
                <li class="nav-item"><a class="nav-link" href="/forum">Forum</a></li>
                <li class="nav-item"><a class="nav-link active" href="/sitemap">Site Map</a></li>
            </ul>

            <form class="d-flex me-3">
                <input class="form-control" type="search" placeholder="Search products">
            </form>

            <a href="/cart" class="me-3 text-dark">
              <i class="fa-solid fa-bag-shopping fs-5"></i>
            </a>

            <div class="dropdown">
              <a href="#" class="text-dark" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-regular fa-user fs-5"></i>
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                <% if (!user) { %>
                  <li><a class="dropdown-item" href="/login">Login</a></li>
                  <li><a class="dropdown-item" href="/register">Register</a></li>
                <% } else { %>
                  <li><a class="dropdown-item" href="/account">My Account</a></li>
                  <% if (user.role === 'admin') { %>
                  <li><a class="dropdown-item" href="/admin">Admin Dashboard</a></li>
                  <% } %>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item text-danger" href="/logout">Logout</a></li>
                <% } %>
              </ul>
            </div>
        </div>
    </div>
</nav>

<nav class="bg-light py-2 border-bottom">
    <div class="container">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/shop">Ecommerce</a></li>
            <li class="breadcrumb-item active">Site Map</li>
        </ol>
    </div>
</nav>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Site Map</h2>
        <p class="text-muted">Overview of the available content on this site.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-5">
        
        <div class="col">
            <div class="h-100">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Shop</h5>
                <div class="d-flex flex-column">
                    <a href="/shop" class="sitemap-link">All Products</a>
                    <a href="/shop?category=shoes" class="sitemap-link">Shoes</a>
                    <a href="/shop?category=apparel" class="sitemap-link">Apparel</a>
                    <a href="/shop?category=accessories" class="sitemap-link">Accessories</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="h-100">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Account</h5>
                <div class="d-flex flex-column">
                    <a href="/login" class="sitemap-link">Login</a>
                    <a href="/register" class="sitemap-link">Register</a>
                    <a href="/account" class="sitemap-link">My Account</a>
                    <a href="/cart" class="sitemap-link">Shopping Cart</a>
                    <a href="/checkout" class="sitemap-link">Checkout</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="h-100">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Community</h5>
                <div class="d-flex flex-column">
                    <a href="/blogs" class="sitemap-link">Blogs</a>
                    <a href="/forum" class="sitemap-link">Forum</a>
                </div>
            </div>
        </div>

    </div>
</div>

<footer class="bg-light pt-5 border-top">
  <div class="container">
    <div class="row">
      <div class="col-md-3 mb-4">
        <h5 class="fw-bold">Support</h5>
        <ul class="list-unstyled small text-muted">
          <li class="mb-2">FAQ</li>
          <li class="mb-2">Terms of use</li>
          <li class="mb-2">Privacy Policy</li>
        </ul>
      </div>
      <div class="col-md-3 mb-4">
        <h5 class="fw-bold">Company</h5>
        <ul class="list-unstyled small text-muted">
          <li class="mb-2">About Us</li>
          <li class="mb-2">Contact</li>
          <li class="mb-2">Careers</li>
        </ul>
      </div>
      <div class="col-md-3 mb-4">
        <h5 class="fw-bold">Shop</h5>
        <ul class="list-unstyled small text-muted">
          <li class="mb-2">My Account</li>
          <li class="mb-2">Checkout</li>
          <li class="mb-2">Cart</li>
        </ul>
      </div>
      <div class="col-md-3 mb-4">
        <h5 class="fw-bold">Stay Updated</h5>
        <form class="d-flex">
          <input type="email" class="form-control form-control-sm" placeholder="Enter Email">
          <button class="btn btn-dark btn-sm ms-2">Subscribe</button>
        </form>
      </div>
    </div>
    <hr class="mt-4">
    <div class="text-center pb-3 small text-muted">
      © 2023 DevCut. All rights reserved.
    </div>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>